# ==========================================
# NeuroScan Brain MRI Detection - Configuration
# ==========================================

# Flask Environment & Secrets
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Server Port (injected dynamically by Render / Cloud host)
PORT=5000

# TensorFlow Log Level (0 = all, 1 = filter INFO, 2 = filter WARNING, 3 = filter ERROR)
TF_CPP_MIN_LOG_LEVEL=2
